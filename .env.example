# PocketBase host port (change if 8090 is already occupied)
POCKETBASE_PORT=8090

# Public URL used by client-side browser and local SSR (e.g. https://pb.yourdomain.com in production)
VITE_POCKETBASE_URL=http://localhost:8090

# Optional PocketBase superuser/admin credentials (for persisting daily usage server-side)
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Optional secret for guest rate-limiting cookies (falls back to OPENROUTER_API_KEY or random runtime secret)
RATE_LIMIT_SECRET=

OPENROUTER_API_KEY=