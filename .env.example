PUBLIC_BASE_URL=http://localhost:5174

# Production / Reverse Proxy configuration (for @sveltejs/adapter-node)
# ORIGIN: Public protocol + domain where users access the app (required by adapter-node for CSRF protection on form actions)
ORIGIN=http://localhost:3000

# PocketBase host port (mapped to 127.0.0.1 for local host access)
POCKETBASE_PORT=8095

# Internal PocketBase URL used by SvelteKit SSR and reverse proxy
INTERNAL_POCKETBASE_URL=http://127.0.0.1:8095

# Optional PocketBase superuser/admin credentials (for persisting daily usage server-side)
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Required in production: secret used to sign sessions and encrypt 2FA secrets (e.g. `openssl rand -hex 32`).
# When migrating an existing deployment, set it to the current RATE_LIMIT_SECRET value so existing
# sessions and encrypted TOTP secrets keep working. RATE_LIMIT_SECRET is only read as a legacy fallback.
AUTH_SECRET=

# Required: shared secret between SvelteKit and PocketBase (e.g. `openssl rand -hex 32`).
# PocketBase rejects user auth, registration and batch requests that do not carry it (see pb_hooks/proxy_guard.pb.js).
POCKETBASE_PROXY_SECRET=

# Interface the web container binds to. Keep 127.0.0.1 when a reverse proxy runs on the same host;
# use 0.0.0.0 only if the app must be reachable directly.
WEB_BIND_ADDRESS=127.0.0.1

# Optional email service configuration for sending 2FA OTP codes
RESEND_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_FROM=

OPENROUTER_API_KEY=